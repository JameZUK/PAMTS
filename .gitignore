__pycache__/
*.pyc
*.log

# Never commit a real config or a token. The example config is explicitly kept.
pamts.toml
!examples/pamts.toml
*-token
*.token
state.json
# Runtime state PAMTS writes next to state.json. watermarks.json is new; the rest are
# here so a working checkout can never commit a live database by accident.
watermarks.json
*.corrupt
events.db
observer.db
*.db-wal
*.db-shm

# Generated from the TARGET kernel's BTF and specific to it, so it must never be
# committed: a stale vmlinux.h silently builds an object for the wrong kernel.
observer/vmlinux.h
*.btf

# Compiled BPF output is a build artefact; build it with observer/Makefile.
*.bpf.o

# Local working notes. This project is public; anything naming a real host,
# address or library belongs in a private repo, not here.
*.local.md
